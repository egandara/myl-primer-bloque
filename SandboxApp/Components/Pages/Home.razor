@page "/"
@inject IWebHostEnvironment Env
@using System.Text.Json
@using System.IO

@if (PartidaIniciada)
{
    <SandboxApp.Components.Pages.Shared.GameBoard NombreJugador="@NombreJugador"
                                                  IdOroInicial="@IdOroInicial"
                                                  MazoBase="MazoPersonalizado"
                                                  UrlCartaZoom="@UrlCartaZoom"
                                                  OnZoomIn="ActivarZoom"
                                                  OnZoomOut="DesactivarZoom" />
}
else if (VistaActual == "Tienda")
{
    <SandboxApp.Components.Pages.TiendaSobres />

    <button @onclick='() => CambiarVista("MenuPrincipal")' style="@EstiloBotonRegresar">
        ⬅ Volver al Menú Principal
    </button>
}
else if (VistaActual == "DeckBuilder")
{
    <SandboxApp.Components.Pages.Shared.DeckBuilder CatalogoCompleto="CatalogoFiltradoPorModo"
                                                    EsModoCarrera="EsModoCarreraActivo"
                                                    ColeccionGladiador="Perfil.Coleccion"
                                                    @bind-MazoPersonalizado="MazoPersonalizado"
                                                    @bind-NombreJugador="NombreJugador"
                                                    @bind-IdOroInicial="IdOroInicial"
                                                    OnOpenMantenedor="AbrirMantenedorCartas"
                                                    OnDeployBattle="(() => PartidaIniciada = true)"
                                                    OnZoomIn="ActivarZoom"
                                                    OnZoomOut="DesactivarZoom" />

    <button @onclick='() => CambiarVista("MenuPrincipal")' style="@EstiloBotonRegresar">
        ⬅ Volver al Menú Principal
    </button>
}
else if (VistaActual == "Album")
{
    <div style="display: flex; flex-direction: column; width: 100vw; height: 100vh; background: #070605; padding: 20px; box-sizing: border-box; font-family: 'Georgia', serif; color: white;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #2d2015; padding-bottom: 10px; margin-bottom: 15px;">
            <div>
                <h2 style="margin: 0; color: #b89047; text-transform: uppercase; letter-spacing: 2px;">🎴 Álbum Real de Colección</h2>
                <span style="font-size: 0.8rem; color: #666;">Mostrando las cartas desbloqueadas de tu inventario. Haz click en una para examinarla en 3D.</span>
            </div>
            <button @onclick='() => CambiarVista("MenuPrincipal")' style="background: linear-gradient(135deg, #1c242b 0%, #0d1217 100%); color: #44ccff; border: 1px solid #285a7a; padding: 8px 20px; font-weight: bold; border-radius: 4px; cursor: pointer; text-transform: uppercase; font-size: 0.75rem;">⬅ Volver al Menú</button>
        </div>

        <div style="flex-grow: 1; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, 130px); gap: 15px; padding-right: 5px; align-content: start;">
            @foreach (var carta in CatalogoCompleto.OrderBy(c => c.Edicion).ThenBy(c => c.Nombre))
            {
                int copias = Perfil.Coleccion.ContainsKey(carta.Nombre) ? Perfil.Coleccion[carta.Nombre] : 0;
                bool laPosee = copias > 0;

                <div @onclick="() => { if (laPosee) ActivarZoom(carta.RutaImagen); }" style="background: #111; border: 1px solid @(laPosee ? "#332418" : "#222"); border-radius: 6px; padding: 6px; text-align: center; position: relative; opacity: @(laPosee ? "1" : "0.22"); filter: @(laPosee ? "none" : "grayscale(100%)"); cursor: @(laPosee ? "pointer" : "default");">
                    <img src="@carta.RutaImagen" style="width: 100%; height: 145px; object-fit: contain; background: black; border-radius: 4px;" />
                    <span style="font-size: 0.6rem; font-weight: bold; display: block; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #ccc;">@carta.Nombre</span>
                    <span style="position: absolute; bottom: 24px; right: 10px; background: #a1582c; color: white; font-size: 0.6rem; font-weight: bold; padding: 1px 5px; border-radius: 3px; border: 1px solid #b89047;">x@copias</span>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(UrlCartaZoom))
    {
        <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); z-index: 9999; display: flex; justify-content: center; align-items: center;" @onclick="DesactivarZoom">
            <img src="@UrlCartaZoom" style="max-height: 90vh; object-fit: contain; box-shadow: 0 10px 40px rgba(0,0,0,0.8); border-radius: 12px;" />
        </div>
    }
}
else
{
    <div style="display: flex; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #1c140e 0%, #030303 100%); color: white; font-family: 'Georgia', serif; padding: 25px; box-sizing: border-box; gap: 20px; user-select: none; overflow: hidden;">

        <div style="width: 28%; height: 100%; display: flex; flex-direction: column; gap: 15px; box-sizing: border-box;">
            <div style="background: linear-gradient(135deg, #181411 0%, #0a0807 100%); border: 2px solid #3a2a1c; border-radius: 8px; padding: 18px; box-shadow: 0 12px 25px rgba(0,0,0,0.6); position: relative; overflow: hidden;">
                <div style="position: absolute; top: -20px; right: -20px; font-size: 5rem; opacity: 0.03; color: #b89047;">👑</div>
                <h3 style="margin: 0 0 12px 0; color: #b89047; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1.5px; border-bottom: 1px solid #3a2a1c; padding-bottom: 6px; font-weight: bold;">🛡️ Perfil del Gladiador</h3>
                <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem; font-family: sans-serif; color: #b0b0b0;">
                    <div style="display: flex; justify-content: space-between; align-items: center;"><span>Rango Activo:</span><span style="color: #fff; font-weight: bold; font-family: 'Georgia'; background: #261c14; padding: 2px 8px; border-radius: 4px; border: 1px solid #4a3725; font-size: 0.75rem;">Gladiador Real</span></div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1f1812; padding-top: 6px;"><span>Billetera:</span><span style="color: #ffcc00; font-weight: bold; font-size: 1.1rem; font-family: monospace; text-shadow: 0 0 4px rgba(255,204,0,0.2);">🪙 @Perfil.Oro</span></div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1f1812; padding-top: 6px;"><span>⚔️ Victorias:</span><span style="color: #00ff55; font-weight: bold; font-family: monospace;">@Perfil.Victorias</span></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;"><span>💀 Derrotas:</span><span style="color: #ff4d4d; font-weight: bold; font-family: monospace;">@Perfil.Derrotas</span></div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1f1812; padding-top: 6px;"><span>🃏 Colección:</span><span style="color: #44ccff; font-weight: bold; font-family: monospace;">@Perfil.Coleccion.Count / @CatalogoCompleto.Count <span style="font-size: 0.7rem; color: #555;">tipos</span></span></div>
                </div>
            </div>

            <div style="flex-grow: 1; background: #0c0c0c; border: 2px solid #222; border-radius: 8px; padding: 15px; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.5);">
                <h3 style="margin: 0 0 12px 0; color: #b89047; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; border-bottom: 1px solid #1f1f1f; padding-bottom: 6px; font-weight: bold;">🗃️ Bóveda de Archivos (.json)</h3>
                <div style="flex-grow: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding-right: 2px;">
                    @if (!ListaMazosFisicos.Any())
                    {
                        <div style="text-align: center; color: #444; font-size: 0.75rem; margin-top: 40px; font-style: italic;">No hay archivos registrados en wwwroot/data/</div>
                    }
                    else
                    {
                        @foreach (var mazo in ListaMazosFisicos)
                        {
                            <div style="background: #141414; border: 1px solid #222; padding: 8px 12px; border-radius: 5px; font-size: 0.8rem; display: flex; justify-content: space-between; align-items: center; transition: background 0.1s;"
                                 onmouseenter="this.style.background='#1a1a1a';" onmouseleave="this.style.background='#141414';">
                                <span style="color: #ddd; font-weight: bold; font-family: sans-serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px;">📜 @mazo.Replace("mazo_", "").Replace(".json", "").Replace("_", " ")</span>
                                <span style="font-size: 0.6rem; background: #261f18; color: #b89047; padding: 2px 6px; border-radius: 3px; border: 1px solid #423325; font-weight: bold;">DECK</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div style="width: 72%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box;">
            <div style="text-align: center; border: 2px solid #2d2015; background: linear-gradient(180deg, #110c08 0%, #070504 100%); border-radius: 8px; padding: 18px; box-shadow: 0 8px 20px rgba(0,0,0,0.6);">
                <h1 style="margin: 0; color: #b89047; text-transform: uppercase; font-size: 1.9rem; letter-spacing: 4px; text-shadow: 0 3px 8px black; font-weight: bold;">🦅 Primer Bloque Crónicas</h1>
                <span style="font-size: 0.8rem; color: #8a6c4c; text-transform: uppercase; letter-spacing: 3px; font-weight: bold; display: block; margin-top: 5px;">Mesa Avanzada de Armado y Apertura</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; flex-grow: 1; margin: 20px 0; align-content: center;">
                <div @onclick='() => EntrarAConstructor(false)' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #4d230b 0%, #170a03 100%); border-color: #a1582c;"
                     onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#ff8844'; this.style.boxShadow='0 12px 25px rgba(255,100,0,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#a1582c'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">⚔️</div>
                    <h3 style="margin: 0; color: #ff9d66; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Modo Sandbox Libre</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Acceso ilimitado al olimpo de las 1,381 cartas del catálogo completo. Prueba estrategias sin frenos de inventario.</p>
                </div>

                <div @onclick='() => EntrarAConstructor(true)' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #0e294a 0%, #040d1a 100%); border-color: #1e5fa8;"
                     onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#44aaff'; this.style.boxShadow='0 12px 25px rgba(0,100,255,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#1e5fa8'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🛡️</div>
                    <h3 style="margin: 0; color: #66b2ff; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Modo Gladiador Carrera</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">El verdadero desafío. Gestiona tu colección y arma tus barajas utilizando **únicamente los naipes que posees** en tu álbum.</p>
                </div>

                <div @onclick='() => CambiarVista("Tienda")' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #4d3914 0%, #140e04 100%); border-color: #b89047;"
                     onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#ffcc00'; this.style.boxShadow='0 12px 25px rgba(255,200,0,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#b89047'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🛒</div>
                    <h3 style="margin: 0; color: #ffcc66; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Mercado de Camelot</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Gasta tus monedas de oro acumuladas. Adquiere estructuras listas para combatir o desata la suerte abriendo sobres.</p>
                </div>

                <div @onclick='() => CambiarVista("Album")' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #0d3b19 0%, #031207 100%); border-color: #28a745;"
                     onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#55ff77'; this.style.boxShadow='0 12px 25px rgba(0,255,100,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#28a745'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🎴</div>
                    <h3 style="margin: 0; color: #66ff88; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Álbum de Colección</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Inspecciona tu galería de trofeos. Examina el arte original, revisa copias repetidas y lleva el registro de tu porcentaje.</p>
                </div>
            </div>

            <button @onclick="AbrirMantenedorCartas" style="width: 100%; background: #17110c; color: #a88867; border: 1px solid #4a3421; padding: 12px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase; border-radius: 6px; cursor: pointer; letter-spacing: 1.5px; transition: background 0.1s;"
                    onmouseenter="this.style.background='#241a12';" onmouseleave="this.style.background='#17110c';">
                ⚙️ Consola del Arquitecto (Mantenedor Base de Datos)
            </button>
        </div>
    </div>
}

<SandboxApp.Components.Pages.Shared.DbMaintenance Open="MostrarMantenedor"
                                                  CatalogoMaestro="CatalogoCompleto"
                                                  AlertIds="IdsSinImagen"
                                                  OnClose="(() => MostrarMantenedor = false)"
                                                  OnSaved="AuditarImagenesFaltantes" />

@code {
    public class CartaJuego
    {
        public string Id { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Edicion { get; set; } = "";
        public string Tipo { get; set; } = "";
        public string Rareza { get; set; } = "";
        public string RutaImagen { get; set; } = "";
        public int? Fuerza { get; set; }
        public int? Costo { get; set; }
        public string Habilidad { get; set; } = "";
        public string ZonaActual { get; set; } = "Castillo";
        public bool IsGirada { get; set; } = false;
        public string? IdAliadoPortador { get; set; } = null;
        public int OrdenEnZona { get; set; } = 0;
        public int FuerzaModificada { get; set; } = 0;
        public bool TieneFuerzaAlterada { get; set; } = false;
        public string? IdAliadoAtacante { get; set; } = null;
    }

    private string VistaActual = "MenuPrincipal";
    private bool EsModoCarreraActivo = false;
    private bool PartidaIniciada = false;
    private string NombreJugador = "Gladiador";
    private string? IdOroInicial = null;

    private List<CartaJuego> CatalogoCompleto = new();
    private List<CartaJuego> CatalogoFiltradoPorModo = new();
    private List<CartaJuego> MazoPersonalizado = new();
    private List<string> ListaMazosFisicos = new();
    private SandboxApp.Models.ProgresoJugador Perfil { get; set; } = new SandboxApp.Models.ProgresoJugador();

    private bool MostrarMantenedor = false;
    private HashSet<string> IdsSinImagen = new();
    private string? UrlCartaZoom = null;

    private string PathProgreso => Path.Combine(Env.WebRootPath, "data", "progreso_gladiador.json");

    private string EstiloTarjetaMenu => "background: #090909; border: 1px solid #222; border-radius: 8px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.15s ease-out; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 16px rgba(0,0,0,0.5);";
    private string EstiloBotonRegresar => "position: fixed; bottom: 20px; left: 20px; background: linear-gradient(135deg, #1c242b 0%, #0d1217 100%); color: #44ccff; border: 1px solid #285a7a; padding: 10px 20px; font-family: 'Georgia', serif; font-size: 0.8rem; font-weight: bold; border-radius: 6px; cursor: pointer; text-transform: uppercase; box-shadow: 0 4px 15px rgba(0,0,0,0.6); z-index: 9999;";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string rutaArchivo = Path.Combine(Env.WebRootPath, "data", "cartas.json");
            if (File.Exists(rutaArchivo))
            {
                string jsonTexto = await File.ReadAllTextAsync(rutaArchivo);
                var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var lista = JsonSerializer.Deserialize<List<CartaJuego>>(jsonTexto, opciones);
                if (lista != null) CatalogoCompleto = lista;
            }
            RefrescarDatosMenuPrincipal();
        }
        catch (Exception ex) { Console.WriteLine($"Error inicial: {ex.Message}"); }
    }

    private void RefrescarDatosMenuPrincipal()
    {
        try
        {
            if (File.Exists(PathProgreso))
            {
                string json = File.ReadAllText(PathProgreso);
                Perfil = JsonSerializer.Deserialize<SandboxApp.Models.ProgresoJugador>(json) ?? new SandboxApp.Models.ProgresoJugador();
            }
            else
            {
                Perfil = new SandboxApp.Models.ProgresoJugador();
            }
        }
        catch { Perfil = new SandboxApp.Models.ProgresoJugador(); }

        try
        {
            string dir = Path.Combine(Env.WebRootPath, "data");
            if (Directory.Exists(dir))
            {
                ListaMazosFisicos = Directory.GetFiles(dir, "mazo_*.json").Select(Path.GetFileName).ToList()!;
            }
        }
        catch { }

        AuditarImagenesFaltantes();
    }

    private void EntrarAConstructor(bool modoCarrera)
    {
        EsModoCarreraActivo = modoCarrera;
        MazoPersonalizado.Clear();
        IdOroInicial = null;

        if (modoCarrera)
        {
            CatalogoFiltradoPorModo = CatalogoCompleto
                .Where(c => Perfil.Coleccion.ContainsKey(c.Nombre) && Perfil.Coleccion[c.Nombre] > 0)
                .ToList();
        }
        else
        {
            CatalogoFiltradoPorModo = CatalogoCompleto;
        }

        VistaActual = "DeckBuilder";
    }

    private void CambiarVista(string destino)
    {
        if (destino == "MenuPrincipal") RefrescarDatosMenuPrincipal();
        VistaActual = destino;
    }

    private void AuditarImagenesFaltantes()
    {
        IdsSinImagen.Clear();
        foreach (var carta in CatalogoCompleto)
        {
            if (string.IsNullOrWhiteSpace(carta.RutaImagen)) { IdsSinImagen.Add(carta.Id); continue; }
            string rutaFisicaDisco = Path.Combine(Env.WebRootPath, carta.RutaImagen.Replace("/", "\\"));
            if (!File.Exists(rutaFisicaDisco)) IdsSinImagen.Add(carta.Id);
        }
    }

    private void AbrirMantenedorCartas() { AuditarImagenesFaltantes(); MostrarMantenedor = true; }
    private void ActivarZoom(string url) => UrlCartaZoom = url;
    private void DesactivarZoom() => UrlCartaZoom = null;
}