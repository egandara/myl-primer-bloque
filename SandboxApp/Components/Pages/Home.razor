}
else
{
    <div style="display: flex; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #1c140e 0%, #030303 100%); color: white; font-family: 'Georgia', serif; padding: 25px; box-sizing: border-box; gap: 20px; user-select: none; overflow: hidden;">
        <div style="width: 28%; height: 100%; display: flex; flex-direction: column; gap: 15px; box-sizing: border-box;">
