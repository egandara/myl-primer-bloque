        </div>

        <div style="width: 72%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box;">
            <div style="text-align: center; border: 2px solid #2d2015; background: linear-gradient(180deg, #110c08 0%, #070504 100%); border-radius: 8px; padding: 18px; box-shadow: 0 8px 20px rgba(0,0,0,0.6);">
                <h1 style="margin: 0; color: #b89047; text-transform: uppercase; font-size: 1.9rem; letter-spacing: 4px; text-shadow: 0 3px 8px black; font-weight: bold;">🦅 Primer Bloque Crónicas</h1>
                <span style="font-size: 0.8rem; color: #8a6c4c; text-transform: uppercase; letter-spacing: 3px; font-weight: bold; display: block; margin-top: 5px;">Mesa Avanzada de Armado y Apertura</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; flex-grow: 1; margin: 20px 0; align-content: center;">
                <div @onclick='() => EntrarAConstructor(false)' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #4d230b 0%, #170a03 100%); border-color: #a1582c;" onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#ff8844'; this.style.boxShadow='0 12px 25px rgba(255,100,0,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#a1582c'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">⚔️</div>
                    <h3 style="margin: 0; color: #ff9d66; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Modo Sandbox Libre</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Acceso ilimitado al olimpo de las 1,381 cartas del catálogo completo. Prueba estrategias sin frenos de inventario.</p>
                </div>
                <div @onclick='() => EntrarAConstructor(true)' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #0e294a 0%, #040d1a 100%); border-color: #1e5fa8;" onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#44aaff'; this.style.boxShadow='0 12px 25px rgba(0,100,255,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#1e5fa8'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🛡️</div>
                    <h3 style="margin: 0; color: #66b2ff; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Modo Gladiador Carrera</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">El verdadero desafío. Gestiona tu colección y arma tus barajas utilizando **únicamente los naipes que posees** en tu álbum.</p>
                </div>

                <div @onclick='() => CambiarVista("LobbyMultiplayer")' style="@EstiloTarjetaMenu grid-column: span 2; background: linear-gradient(135deg, #3d0c22 0%, #17040d 100%); border-color: #a81e5f;" onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#ff66b2'; this.style.boxShadow='0 12px 25px rgba(255,100,178,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#a81e5f'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🌍</div>
                    <h3 style="margin: 0; color: #ff66b2; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Duelo Multijugador</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.8rem; color: #ccc; font-family: sans-serif; max-width: 500px; line-height: 14px; text-align: center;">Enfréntate a otro gladiador en tiempo real. Crea una sala o únete a una existente usando un código secreto.</p>
                </div>

                <div @onclick='() => CambiarVista("Tienda")' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #4d3914 0%, #140e04 100%); border-color: #b89047;" onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#ffcc00'; this.style.boxShadow='0 12px 25px rgba(255,200,0,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#b89047'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🛒</div>
                    <h3 style="margin: 0; color: #ffcc66; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Mercado de Camelot</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Gasta tus monedas de oro acumuladas. Adquiere estructuras listas para combatir o desata la suerte abriendo sobres.</p>
                </div>
                <div @onclick='() => CambiarVista("Album")' style="@EstiloTarjetaMenu background: linear-gradient(135deg, #0d3b19 0%, #031207 100%); border-color: #28a745;" onmouseenter="this.style.transform='translateY(-5px)'; this.style.borderColor='#55ff77'; this.style.boxShadow='0 12px 25px rgba(0,255,100,0.15)';" onmouseleave="this.style.transform='none'; this.style.borderColor='#28a745'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.5)';">
                    <div style="font-size: 2.5rem; margin-bottom: 8px; filter: drop-shadow(0 4px 6px black);">🎴</div>
                    <h3 style="margin: 0; color: #66ff88; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 1px; font-weight: bold;">Álbum de Colección</h3>
                    <p style="margin: 6px 0 0 0; font-size: 0.75rem; color: #aaa; font-family: sans-serif; max-width: 340px; line-height: 13px; text-align: center;">Inspecciona tu galería de trofeos. Examina el arte original, revisa copias repetidas y lleva el registro de tu porcentaje.</p>
                </div>
            </div>

            <button @onclick="AbrirMantenedorCartas" style="width: 100%; background: #17110c; color: #a88867; border: 1px solid #4a3421; padding: 12px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase; border-radius: 6px; cursor: pointer; letter-spacing: 1.5px; transition: background 0.1s;" onmouseenter="this.style.background='#241a12';" onmouseleave="this.style.background='#17110c';">Consola del Arquitecto (Mantenedor Base de Datos)</button>
        </div>
    </div>
}

<SandboxApp.Components.Pages.Shared.DbMaintenance Open="MostrarMantenedor"
                                                  CatalogoMaestro="CatalogoCompleto"
                                                  AlertIds="IdsSinImagen"
                                                  OnClose="(() => MostrarMantenedor = false)"
                                                  OnSaved="AuditarImagenesFaltantes" />

@code {
    public class CartaJuego
    {
        public string Id { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Edicion { get; set; } = "";
        public string Tipo { get; set; } = "";
        public string Rareza { get; set; } = "";
        public string RutaImagen { get; set; } = "";
        public int? Fuerza { get; set; }
        public int? Costo { get; set; }
        public string Habilidad { get; set; } = "";
        public string ZonaActual { get; set; } = "Castillo";
        public bool IsGirada { get; set; } = false;
        public string? IdAliadoPortador { get; set; } = null;
        public int OrdenEnZona { get; set; } = 0;
        public int FuerzaModificada { get; set; } = 0;
        public bool TieneFuerzaAlterada { get; set; } = false;
        public string? IdAliadoAtacante { get; set; } = null;
    }

    public class RanuraSobre
    {
        public CartaJuego Carta { get; set; } = new CartaJuego();
        public bool Revelada { get; set; } = false;
        public bool EsNueva { get; set; } = false;
    }

    public class ProductoTienda
    {
        public string Id { get; set; } = "";
        public string Tipo { get; set; } = "Sobre";
        public string Nombre { get; set; } = "";
        public string Edicion { get; set; } = "";
        public int Precio { get; set; } = 500;
        public string RutaImagen { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public int CantidadOros { get; set; } = 1;
        public int CantidadVasallos { get; set; } = 5;
        public int CantidadCortesanos { get; set; } = 3;
        public int CantidadReales { get; set; } = 1;
        public int ProbabilidadUpgrade { get; set; } = 20;
    }

    public class MazoGuardadoDTO
    {
        public string NombreMazo { get; set; } = "Mitos Deck";
        public List<string> NombresCartas { get; set; } = new List<string>();
        public string? NombreOroInicial { get; set; }
    }

    private string VistaActual = "MenuPrincipal";
    private bool EsModoCarreraActivo = false;
    private bool PartidaIniciada = false;
    private string NombreJugador = "Gladiador";
    private string? IdOroInicial = null;

    // --- VARIABLES DE MULTIJUGADOR ---
    private string? SalaIdActiva = null;
    private string InputCodigoSala = "";
    private string ErrorSala = "";
    private bool EsMultiplayer => !string.IsNullOrEmpty(SalaIdActiva);
    // ---------------------------------

    private List<CartaJuego> CatalogoCompleto = new();
    private List<CartaJuego> CatalogoFiltradoPorModo = new();
    private List<CartaJuego> MazoPersonalizado = new();
    private List<string> ListaMazosFisicos = new();
    private SandboxApp.Models.ProgresoJugador Perfil { get; set; } = new SandboxApp.Models.ProgresoJugador();
    private bool MostrarMantenedor = false;
    private HashSet<string> IdsSinImagen = new();
    private string? UrlCartaZoom = null;
    private int PaginaActualAlbum = 0;
    private string FiltroAlbumEdicion = "Todas";
    private string AvatarActivoKey = "Caballero Real";
    private string AvatarActivoIcono = "🛡️";

    private Dictionary<string, string> AvataresDisponibles = new()
    {
        { "Caballero Real", "🛡️" }, { "Mago Merlín", "🔮" }, { "Morgana la Bruja", "🧪" },
        { "San Jorge", "🐉" }, { "Rey Supremo", "👑" }, { "Cazador Celta", "🏹" },
        { "Sacerdote Santo", "⚜️" }, { "Gladiador Bárbaro", "🪓" }
    };

    private string PathProgreso => Path.Combine(Env.WebRootPath, "data", "progreso_gladiador.json");
    private string EstiloTarjetaMenu => "background: #090909; border: 1px solid #222; border-radius: 8px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.15s ease-out; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 16px rgba(0,0,0,0.5);";
    private string EstiloBotonRegresar => "position: fixed; bottom: 20px; left: 20px; background: linear-gradient(135deg, #1c242b 0%, #0d1217 100%); color: #44ccff; border: 1px solid #285a7a; padding: 10px 20px; font-family: 'Georgia', serif; font-size: 0.8rem; font-weight: bold; border-radius: 6px; cursor: pointer; text-transform: uppercase; box-shadow: 0 4px 15px rgba(0,0,0,0.6); z-index: 9999;";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            string rutaArchivo = Path.Combine(Env.WebRootPath, "data", "cartas.json");
            if (File.Exists(rutaArchivo))
            {
                string jsonTexto = await File.ReadAllTextAsync(rutaArchivo);
                var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var lista = JsonSerializer.Deserialize<List<CartaJuego>>(jsonTexto, opciones);
                if (lista != null) CatalogoCompleto = lista;
            }
            RefrescarDatosMenuPrincipal();
        }
        catch (Exception ex) { Console.WriteLine($"Error inicial: {ex.Message}"); }
    }

    private void RefrescarDatosMenuPrincipal()
    {
        try
        {
            if (File.Exists(PathProgreso))
            {
                string json = File.ReadAllText(PathProgreso);
                Perfil = JsonSerializer.Deserialize<SandboxApp.Models.ProgresoJugador>(json) ?? new SandboxApp.Models.ProgresoJugador();
                if (!string.IsNullOrWhiteSpace(Perfil.NombreGladiador))
                {
                    NombreJugador = Perfil.NombreGladiador;
                }
            }
            else
            {
                Perfil = new SandboxApp.Models.ProgresoJugador();
            }
        }
        catch { Perfil = new SandboxApp.Models.ProgresoJugador(); }

        try
        {
            string dir = Path.Combine(Env.WebRootPath, "data");
            if (Directory.Exists(dir))
            {
                ListaMazosFisicos = Directory.GetFiles(dir, "mazo_*.json").Select(Path.GetFileName).ToList()!;
            }
        }
        catch { }

        AuditarImagenesFaltantes();
    }

    private void SalvarCambiosPerfilManual()
    {
        try
        {
            NombreJugador = Perfil.NombreGladiador;
            string json = JsonSerializer.Serialize(Perfil, new JsonSerializerOptions { WriteIndented = true });
            File.WriteAllText(PathProgreso, json);
        }
        catch { }
    }

    private void SeleccionarAvatarLocal(string nombre, string icono)
    {
        AvatarActivoKey = nombre;
        AvatarActivoIcono = icono;
    }

    private string CalcularTituloDinamico()
    {
        if (Perfil.Victorias >= 50) return "Héroe Ancestral";
        if (Perfil.Victorias >= 20) return "Señor de Camelot";
        if (Perfil.Victorias >= 5) return "Caballero de la Mesa Redonda";
        return "Escudero Aspirante";
    }

    // --- MÉTODOS MULTIJUGADOR ---
    private void CrearSalaMultiplayer()
    {
        ErrorSala = "";
        var partida = GameManager.CrearPartida(NombreJugador);
        SalaIdActiva = partida.SalaId;
        // Te llevamos al Constructor de Mazos (en modo libre temporalmente) para que te armes el mazo antes de la batalla
        EntrarAConstructor(false);
    }

    private void UnirseSalaMultiplayer()
    {
        ErrorSala = "";
        if (string.IsNullOrWhiteSpace(InputCodigoSala))
        {
            ErrorSala = "Debes ingresar un código de sala.";
            return;
        }

        var partida = GameManager.UnirseAPartida(InputCodigoSala, NombreJugador);
        if (partida != null)
        {
            SalaIdActiva = partida.SalaId;
            EntrarAConstructor(false);
        }
        else
        {
            ErrorSala = "La sala no existe o ya está llena.";
        }
    }
    // ----------------------------

    private void EntrarAConstructor(bool modoCarrera)
    {
        EsModoCarreraActivo = modoCarrera;
        MazoPersonalizado.Clear();
        IdOroInicial = null;

        if (modoCarrera)
        {
            CatalogoFiltradoPorModo = CatalogoCompleto
                .Where(c => Perfil.Coleccion.ContainsKey(c.Nombre) && Perfil.Coleccion[c.Nombre] > 0)
                .ToList();
        }
        else
        {
            CatalogoFiltradoPorModo = CatalogoCompleto;
        }

        VistaActual = "DeckBuilder";
    }

    private void CambiarVista(string destino)
    {
        if (destino == "MenuPrincipal") RefrescarDatosMenuPrincipal();
        VistaActual = destino;
    }

    private void ProcesarDerrota()
    {
        Perfil.Derrotas++;
        SalvarCambiosPerfilManual();
        PartidaIniciada = false;
        SalaIdActiva = null;
        VistaActual = "MenuPrincipal";
    }

    private void ProcesarEmpate()
    {
        PartidaIniciada = false;
        SalaIdActiva = null;
        VistaActual = "MenuPrincipal";
    }

    private void AuditarImagenesFaltantes()
    {
        IdsSinImagen.Clear();
        foreach (var carta in CatalogoCompleto)
        {
            if (string.IsNullOrWhiteSpace(carta.RutaImagen)) { IdsSinImagen.Add(carta.Id); continue; }
            string rutaFisicaDisco = Path.Combine(Env.WebRootPath, carta.RutaImagen.Replace("/", "\\"));
            if (!File.Exists(rutaFisicaDisco)) IdsSinImagen.Add(carta.Id);
        }
    }

    private void AbrirMantenedorCartas() { AuditarImagenesFaltantes(); MostrarMantenedor = true; }
    private void ActivarZoom(string url) => UrlCartaZoom = url;
    private void DesactivarZoom() => UrlCartaZoom = null;
}