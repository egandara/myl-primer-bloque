                <button @onclick='() => CambiarVista("GestorPerfil")' style="position: absolute; top: 12px; right: 12px; background: #261c14; border: 1px solid #4a3725; color: #ffcc00; font-size: 0.65rem; font-weight: bold; padding: 3px 8px; border-radius: 4px; cursor: pointer; text-transform: uppercase;">⚙️ Config</button>
                <div style="font-size: 2.2rem; margin-bottom: 2px;">@AvatarActivoIcono</div>
