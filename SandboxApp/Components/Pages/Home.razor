                <input type="text" @bind="InputCodigoSala" placeholder="CÓDIGO (Ej: A4F2)" style="width: 100%; padding: 12px; background: #1a1a1a; border: 1px solid #b89047; color: #ffcc00; border-radius: 4px; text-align: center; text-transform: uppercase; margin-bottom: 15px; box-sizing: border-box; font-size: 1.2rem; font-weight: bold; letter-spacing: 2px;" />

                <button @onclick="UnirseSalaMultiplayer" style="width: 100%; background: linear-gradient(135deg, #1e5fa8 0%, #0d2e54 100%); color: white; border: 1px solid #44aaff; padding: 14px; font-weight: bold; border-radius: 4px; cursor: pointer; text-transform: uppercase; font-size: 0.9rem; box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
